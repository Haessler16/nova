# ---------------------------------------------------------------------------
# NOVA PMS — local development environment
# Copy this file to `.env` and adjust only if needed. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# Authentication mode:
# - `dev-header` trusts X-Dev-User-Id ONLY outside production (tests/local dev).
# - `local-session` enables cookie sessions, CSRF and login rate limiting.
# The API refuses `dev-header` when NODE_ENV=production.
AUTH_MODE=dev-header

# Required when AUTH_MODE=local-session. Use at least 32 random characters and
# never commit a real production secret.
CSRF_SECRET=local-only-change-me-0123456789abcdef
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=nova_session
CSRF_COOKIE_NAME=nova_csrf
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Global mutation limiter (POST/PUT/PATCH/DELETE), Redis-backed.
# Two fixed windows are checked: client IP and organization/property selector.
MUTATION_RATE_LIMIT_ENABLED=true
MUTATION_RATE_LIMIT_MAX=600
MUTATION_RATE_LIMIT_WINDOW_SECONDS=60

# MFA / auth hardening (local-session). MFA_ENCRYPTION_KEY is required to enroll
# or enable MFA; use at least 32 random characters in non-local environments.
MFA_ENCRYPTION_KEY=local-only-mfa-key-change-me-0123456789abcdef0123456789
MFA_ISSUER=NOVA PMS
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
MFA_CHALLENGE_TTL_SECONDS=300
# log|response|none. `response` returns one-time tokens in JSON for tests only;
# production forces `none` and must use an email provider.
AUTH_TOKEN_DELIVERY=log

# Room block expiry scheduler (PostgreSQL advisory lock; disabled automatically in Jest).
ROOM_BLOCK_EXPIRY_ENABLED=true
ROOM_BLOCK_EXPIRY_INTERVAL_SECONDS=60

# Metrics endpoint (/metrics, excluded from /api/v1 prefix).
# Production refuses to boot with metrics enabled and no token.
METRICS_ENABLED=true
# METRICS_TOKEN=change-me-for-shared-environments

# PostgreSQL / Prisma
DATABASE_URL=postgresql://nova:nova_local_only@localhost:5432/nova_pms?schema=public

# Redis (health/readiness and future coordination; never source of truth)
REDIS_URL=redis://localhost:6379

# Audit metadata hard limit enforced by the API before persisting.
AUDIT_METADATA_MAX_BYTES=8192

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
