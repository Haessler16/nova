# ---------------------------------------------------------------------------
# NOVA PMS — local development environment
# Copy this file to `.env` and adjust only if needed. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# Development-only authentication.
# `dev-header` trusts X-Dev-User-Id ONLY outside production. The API refuses
# this mode when NODE_ENV=production, even if the variable is set here.
AUTH_MODE=dev-header

# PostgreSQL / Prisma
DATABASE_URL=postgresql://nova:nova_local_only@localhost:5432/nova_pms?schema=public

# Redis (health/readiness and future coordination; never source of truth)
REDIS_URL=redis://localhost:6379

# Audit metadata hard limit enforced by the API before persisting.
AUDIT_METADATA_MAX_BYTES=8192

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
