# ---------------------------------------------------------------------------
# NOVA PMS — local development environment
# Copy this file to `.env` and adjust only if needed. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# Authentication mode:
# - `dev-header` trusts X-Dev-User-Id ONLY outside production (tests/local dev).
# - `local-session` enables cookie sessions, CSRF and login rate limiting.
# The API refuses `dev-header` when NODE_ENV=production.
AUTH_MODE=dev-header

# Required when AUTH_MODE=local-session. Use at least 32 random characters and
# never commit a real production secret.
CSRF_SECRET=local-only-change-me-0123456789abcdef
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=nova_session
CSRF_COOKIE_NAME=nova_csrf
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# PostgreSQL / Prisma
DATABASE_URL=postgresql://nova:nova_local_only@localhost:5432/nova_pms?schema=public

# Redis (health/readiness and future coordination; never source of truth)
REDIS_URL=redis://localhost:6379

# Audit metadata hard limit enforced by the API before persisting.
AUDIT_METADATA_MAX_BYTES=8192

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
