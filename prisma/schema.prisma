generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DISABLED
}

enum HousekeepingState {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
}

enum RoomOperationalState {
  AVAILABLE
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

enum RoomBlockType {
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

enum RoomBlockStatus {
  ACTIVE
  RELEASED
  EXPIRED
}

enum RoomStatusCategory {
  OPERATIONAL
  HOUSEKEEPING
}

enum GuestDocumentType {
  CPF
  PASSPORT
  RG
  NATIONAL_ID
  DRIVER_LICENSE
  OTHER
}

enum ReservationGuestRole {
  PRIMARY
  COMPANION
}

enum GuestAgeGroup {
  ADULT
  MINOR
  UNKNOWN
}

enum ReservationGuestOrigin {
  LEGACY_BACKFILL
  MANUAL
  PRE_CHECKIN
  IMPORT
}

enum MinorSupervision {
  ACCOMPANIED
  UNACCOMPANIED_AUTHORIZED
  UNACCOMPANIED_WITHOUT_AUTHORIZATION
  UNKNOWN
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum StayStatus {
  IN_HOUSE
  CHECKED_OUT
}

enum IncidentType {
  NOTE
  MAINTENANCE
  COMPLAINT
  SAFETY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum FolioStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum FolioLineStatus {
  POSTED
  VOID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  REFUND
  ADJUSTMENT
}

enum OperationalCloseStatus {
  CLOSED
  REOPENED
}

enum DocumentStatus {
  GENERATED
  SIGNATURE_RECEIVED
  VOIDED
}

enum DocumentPrintEventType {
  PRINT_DIALOG_OPENED
  PRINT_CONFIRMED_BY_STAFF
  REPRINT_REQUESTED
}

enum InstructionCategory {
  PAYMENT
  MEAL
  BILLING
  ROOM
  ARRIVAL
  IMPORTANT
  EXTRA
  CONFIDENTIAL
  GENERAL
}

enum InstructionPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum InstructionStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  DISMISSED
  NEEDS_CLARIFICATION
}

enum InstructionSource {
  RESERVATIONS
  FRONT_DESK
  GUEST
  CHANNEL
  IMPORT
  SYSTEM
}

enum InstructionVisibility {
  ALL_AUTHORIZED
  FRONT_DESK
  RESERVATIONS
  FINANCE
  MANAGEMENT
}

enum InstructionActionType {
  PAYMENT_PREAUTHORIZATION
  VERIFY_PAYMENT
  BILLING_TASK
  ARRIVAL_REMINDER
}

enum InstructionExecutionMoment {
  PRE_ARRIVAL
  CHECK_IN
  DURING_STAY
  CHECK_OUT
}

enum InstructionPaymentMethod {
  CREDIT_CARD
  PIX
  CASH
  BANK_TRANSFER
  UNKNOWN
}

enum InstructionEventType {
  CREATED
  UPDATED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  DISMISSED
  NEEDS_CLARIFICATION
  CONFIRMED_FROM_SOURCE
}

enum PilotFeedbackCategory {
  BUG
  UX
  QUESTION
  OTHER
}

enum PilotFeedbackStatus {
  OPEN
  REVIEWED
  ARCHIVED
}

// Phase 6 — pilot onboarding feedback. Messages are property-scoped, written by
// a member of the organization and reviewed explicitly; they never mutate
// operational records.
/// Idempotency and audit header for a confirmed guest CSV import. Guest rows
/// live in Guest; this table only records the import outcome and never stores
/// the CSV or personal data.
model GuestImport {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  propertyId      String       @db.Uuid
  idempotencyKey  String       @db.VarChar(64)
  rowCount        Int
  createdCount    Int
  createdByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy       User?        @relation("GuestImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([propertyId, idempotencyKey])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, createdAt])
}

model PilotFeedback {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  propertyId       String                @db.Uuid
  userId           String                @db.Uuid
  category         PilotFeedbackCategory @default(OTHER)
  message          String
  rating           Int?
  context          Json?
  status           PilotFeedbackStatus   @default(OPEN)
  reviewedAt       DateTime?
  reviewedByUserId String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user         User         @relation("PilotFeedbackAuthor", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("PilotFeedbackReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, propertyId, createdAt])
}

model Organization {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  status              RecordStatus         @default(ACTIVE)
  properties          Property[]
  memberships         Membership[]
  roles               Role[]
  propertyMemberships PropertyMembership[]
  auditEvents         AuditEvent[]
  securityEvents      SecurityEvent[]
  roomTypes           RoomType[]
  rooms               Room[]
  roomBlocks          RoomBlock[]
  roomStatusHistory   RoomStatusHistory[]
  guests              Guest[]
  guestFnrhProfiles   GuestFnrhProfile[]
  reservations        Reservation[]
  reservationGuests   ReservationGuest[]
  reservationHistory  ReservationHistory[]
  stays               Stay[]
  incidents           Incident[]
  folios              Folio[]
  folioLines          FolioLine[]
  payments            Payment[]
  cashSessions        CashSession[]
  cashMovements       CashMovement[]
  operationalCloses   OperationalClose[]
  pilotFeedback       PilotFeedback[]
  guestImports        GuestImport[]
  documentTemplates   DocumentTemplate[]
  generatedDocuments  GeneratedDocument[]
  documentPrintEvents DocumentPrintEvent[]
  instructions        ReservationInstruction[]
  sourceNotes         ReservationSourceNote[]
  instructionEvents   InstructionEvent[]
  guestNotes          GuestNote[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
}

model Property {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  name                String
  code                String
  timezone            String               @default("America/Sao_Paulo")
  currencyCode        String               @default("BRL") @db.VarChar(3)
  operationalDayStart String               @default("06:00")
  status              RecordStatus         @default(ACTIVE)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  propertyMemberships PropertyMembership[]
  auditEvents         AuditEvent[]
  roomTypes           RoomType[]
  rooms               Room[]
  roomBlocks          RoomBlock[]
  roomStatusHistory   RoomStatusHistory[]
  guests              Guest[]
  guestFnrhProfiles   GuestFnrhProfile[]
  reservations        Reservation[]
  reservationGuests   ReservationGuest[]
  reservationHistory  ReservationHistory[]
  stays               Stay[]
  incidents           Incident[]
  folios              Folio[]
  folioLines          FolioLine[]
  payments            Payment[]
  cashSessions        CashSession[]
  cashMovements       CashMovement[]
  operationalCloses   OperationalClose[]
  pilotFeedback       PilotFeedback[]
  guestImports        GuestImport[]
  documentTemplates   DocumentTemplate[]
  generatedDocuments  GeneratedDocument[]
  documentPrintEvents DocumentPrintEvent[]
  instructions        ReservationInstruction[]
  sourceNotes         ReservationSourceNote[]
  instructionEvents   InstructionEvent[]
  guestNotes          GuestNote[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model User {
  id                       String                   @id @default(uuid()) @db.Uuid
  email                    String                   @unique
  name                     String
  passwordHash             String?
  status                   RecordStatus             @default(INVITED)
  mfaSecret                String?
  mfaEnabled               Boolean                  @default(false)
  mfaEnrolledAt            DateTime?
  mfaLastUsedStep          Int?
  emailVerifiedAt          DateTime?
  failedLoginAttempts      Int                      @default(0)
  lockedUntil              DateTime?
  passwordChangedAt        DateTime?
  memberships              Membership[]
  propertyMemberships      PropertyMembership[]
  auditEvents              AuditEvent[]             @relation("AuditActor")
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  securityEvents           SecurityEvent[]          @relation("SecurityEventSubject")
  securityActions          SecurityEvent[]          @relation("SecurityEventActor")
  roomBlocksCreated        RoomBlock[]              @relation("RoomBlockCreatedBy")
  roomStatusHistory        RoomStatusHistory[]      @relation("RoomStatusHistoryActor")
  reservationsCreated      Reservation[]            @relation("ReservationCreatedBy")
  reservationHistory       ReservationHistory[]     @relation("ReservationHistoryActor")
  staysCheckedIn           Stay[]                   @relation("StayCheckedInBy")
  staysCheckedOut          Stay[]                   @relation("StayCheckedOutBy")
  incidentsCreated         Incident[]               @relation("IncidentCreatedBy")
  incidentsResolved        Incident[]               @relation("IncidentResolvedBy")
  foliosOpened             Folio[]                  @relation("FolioOpenedBy")
  folioLinesCreated        FolioLine[]              @relation("FolioLineCreatedBy")
  paymentsReceived         Payment[]                @relation("PaymentReceivedBy")
  cashSessionsOpened       CashSession[]            @relation("CashSessionOpenedBy")
  cashSessionsClosed       CashSession[]            @relation("CashSessionClosedBy")
  cashMovements            CashMovement[]           @relation("CashMovementRecordedBy")
  operationalCloses        OperationalClose[]       @relation("OperationalCloseClosedBy")
  operationalReopens       OperationalClose[]       @relation("OperationalCloseReopenedBy")
  pilotFeedback            PilotFeedback[]          @relation("PilotFeedbackAuthor")
  pilotFeedbackReviewed    PilotFeedback[]          @relation("PilotFeedbackReviewer")
  guestImports             GuestImport[]            @relation("GuestImportCreatedBy")
  documentTemplatesCreated DocumentTemplate[]       @relation("DocumentTemplateCreatedBy")
  documentsGenerated       GeneratedDocument[]      @relation("DocumentGeneratedBy")
  documentsReceived        GeneratedDocument[]      @relation("DocumentReceivedBy")
  documentPrintEvents      DocumentPrintEvent[]     @relation("DocumentPrintRequestedBy")
  instructionsCreated      ReservationInstruction[] @relation("InstructionCreatedBy")
  instructionsCompleted    ReservationInstruction[] @relation("InstructionCompletedBy")
  instructionsAssigned     ReservationInstruction[] @relation("InstructionAssignedTo")
  instructionEvents        InstructionEvent[]       @relation("InstructionEventActor")
  sourceNotesImported      ReservationSourceNote[]   @relation("SourceNoteImportedBy")
  guestNotesCreated        GuestNote[]              @relation("GuestNoteCreatedBy")
  guestNotesUpdated        GuestNote[]              @relation("GuestNoteUpdatedBy")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([status])
  @@index([lockedUntil])
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String?      @db.Uuid
  status         RecordStatus @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role?        @relation("MembershipRole", fields: [roleId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, roleId])
}

model Role {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String
  key            String
  system         Boolean              @default(false)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  propertyRoles  PropertyMembership[]
  memberships    Membership[]         @relation("MembershipRole")
  permissions    RolePermission[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, key])
  @@unique([organizationId, id])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model PropertyMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  propertyId     String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  status         RecordStatus @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([propertyId, userId])
  @@index([organizationId, userId, status])
  @@index([organizationId, propertyId, status])
  @@index([propertyId, status])
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(64)
  userAgent     String?   @db.VarChar(255)
  ipHash        String?   @db.VarChar(64)
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  lastSeenAt    DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  propertyId     String?      @db.Uuid
  actorUserId    String?      @db.Uuid
  action         String
  entityType     String
  entityId       String
  occurredAt     DateTime     @default(now())
  correlationId  String?
  reason         String?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([propertyId, occurredAt])
  @@index([entityType, entityId])
}

model RoomType {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  propertyId       String        @db.Uuid
  name             String
  code             String
  description      String?
  capacityAdults   Int           @default(1)
  capacityChildren Int           @default(0)
  bedType          String?
  status           RecordStatus  @default(ACTIVE)
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  rooms            Room[]
  reservations     Reservation[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([propertyId, code])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status])
}

model Room {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  propertyId        String               @db.Uuid
  roomTypeId        String               @db.Uuid
  number            String
  floor             String?
  building          String?
  attributes        String[]             @default([])
  housekeepingState HousekeepingState    @default(DIRTY)
  operationalState  RoomOperationalState @default(AVAILABLE)
  status            RecordStatus         @default(ACTIVE)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property          Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomType          RoomType             @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  blocks            RoomBlock[]
  statusHistory     RoomStatusHistory[]
  reservations      Reservation[]
  stays             Stay[]
  incidents         Incident[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([propertyId, number])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status])
  @@index([propertyId, roomTypeId])
  @@index([propertyId, housekeepingState])
  @@index([propertyId, operationalState])
}

model RoomBlock {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  propertyId      String              @db.Uuid
  roomId          String              @db.Uuid
  type            RoomBlockType
  status          RoomBlockStatus     @default(ACTIVE)
  reason          String
  startsAt        DateTime
  endsAt          DateTime
  createdByUserId String?             @db.Uuid
  releasedAt      DateTime?
  releaseReason   String?
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room            Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("RoomBlockCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  statusHistory   RoomStatusHistory[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status, startsAt])
  @@index([roomId, status, startsAt])
  @@index([organizationId, createdByUserId])
}

model RoomStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  propertyId     String             @db.Uuid
  roomId         String             @db.Uuid
  roomBlockId    String?            @db.Uuid
  category       RoomStatusCategory
  fromState      String?
  toState        String
  reason         String?
  actorUserId    String?            @db.Uuid
  correlationId  String?
  occurredAt     DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room           Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  roomBlock      RoomBlock?         @relation(fields: [roomBlockId], references: [id], onDelete: Restrict)
  actor          User?              @relation("RoomStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, propertyId, occurredAt])
  @@index([roomId, occurredAt])
  @@index([organizationId, propertyId, roomId])
}

model Guest {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  propertyId        String              @db.Uuid
  fullName          String
  email             String?
  phone             String?
  documentType      GuestDocumentType?
  documentNumber    String?
  notes             String?
  status            RecordStatus        @default(ACTIVE)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property          Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservations      Reservation[]
  stays             Stay[]
  fnrhProfile       GuestFnrhProfile?
  reservationGuests ReservationGuest[]  @relation("ReservationGuestGuest")
  documents         GeneratedDocument[] @relation("DocumentGuest")
  notesHistory      GuestNote[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, propertyId, fullName])
  @@index([organizationId, propertyId, email])
}

/// FNRH-specific data kept separate from the operational guest profile. The
/// profile is optional and only the fields needed by the integration are
/// populated; it is never returned by the guest list.
model GuestFnrhProfile {
  guestId                String       @id @db.Uuid
  organizationId         String       @db.Uuid
  propertyId             String       @db.Uuid
  socialName             String?
  birthDate              DateTime?    @db.Date
  nationalityCountryCode String?      @db.VarChar(2)
  residenceCountryCode   String?      @db.VarChar(2)
  genderCode             String?      @db.VarChar(32)
  raceCode               String?      @db.VarChar(32)
  disabilityCode         String?      @db.VarChar(32)
  disabilityTypeCode     String?      @db.VarChar(32)
  postalCode             String?      @db.VarChar(16)
  street                 String?      @db.VarChar(160)
  number                 String?      @db.VarChar(20)
  complement             String?      @db.VarChar(80)
  district               String?      @db.VarChar(80)
  cityIbgeCode           String?      @db.VarChar(7)
  cityName               String?      @db.VarChar(120)
  stateCode              String?      @db.VarChar(2)
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property               Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest                  Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId, propertyId])
}

/// A stay for one or more guests. `checkInDate`/`checkOutDate` are hotel
/// calendar dates (property timezone) and the stay occupies
/// [checkInDate, checkOutDate). One room per reservation in this phase.
model Reservation {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @db.Uuid
  propertyId         String               @db.Uuid
  code               String               @db.VarChar(32)
  status             ReservationStatus    @default(CONFIRMED)
  source             String?              @db.VarChar(32)
  checkInDate        DateTime             @db.Date
  checkOutDate       DateTime             @db.Date
  adults             Int                  @default(1)
  children           Int                  @default(0)
  guestId            String               @db.Uuid
  roomTypeId         String               @db.Uuid
  roomId             String?              @db.Uuid
  notes              String?
  idempotencyKey     String?              @db.VarChar(64)
  createdByUserId    String?              @db.Uuid
  cancelledAt        DateTime?
  cancellationReason String?
  noShowAt           DateTime?
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property           Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest              Guest                @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomType           RoomType             @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room               Room?                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy          User?                @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  history            ReservationHistory[]
  guests             ReservationGuest[]
  stay               Stay?
  incidents          Incident[]
  folios             Folio[]
  payments           Payment[]
  documents          GeneratedDocument[]
  instructions       ReservationInstruction[]
  sourceNotes        ReservationSourceNote[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([propertyId, code])
  @@unique([propertyId, idempotencyKey])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status, checkInDate])
  @@index([organizationId, propertyId, roomId, checkInDate, checkOutDate])
  @@index([organizationId, propertyId, guestId])
}

/// Reservation-scoped party. Exactly one PRIMARY must match
/// Reservation.guestId; companions and dependents are optional. Minors and
/// legally incapable adults point at an adult responsible in the same party.
model ReservationGuest {
  id                            String                 @id @default(uuid()) @db.Uuid
  organizationId                String                 @db.Uuid
  propertyId                    String                 @db.Uuid
  reservationId                 String                 @db.Uuid
  guestId                       String                 @db.Uuid
  role                          ReservationGuestRole
  ageGroup                      GuestAgeGroup          @default(UNKNOWN)
  legalIncapacity               Boolean                @default(false)
  minorSupervision              MinorSupervision?
  authorizationReference        String?                @db.VarChar(120)
  origin                        ReservationGuestOrigin @default(MANUAL)
  responsibleReservationGuestId String?                @db.Uuid
  organization                  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property                      Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation                   Reservation            @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest                         Guest                  @relation("ReservationGuestGuest", fields: [guestId], references: [id], onDelete: Restrict)
  responsible                   ReservationGuest?      @relation("ReservationGuestResponsible", fields: [responsibleReservationGuestId], references: [id], onDelete: Restrict)
  dependents                    ReservationGuest[]     @relation("ReservationGuestResponsible")
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  @@unique([reservationId, guestId])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, reservationId])
  @@index([organizationId, propertyId, guestId])
  @@index([responsibleReservationGuestId])
}

/// Append-only trail for reservation creation, modification, room assignment
/// and cancellation. The database trigger rejects UPDATE/DELETE/TRUNCATE.
model ReservationHistory {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  propertyId     String             @db.Uuid
  reservationId  String             @db.Uuid
  action         String
  fromStatus     ReservationStatus?
  toStatus       ReservationStatus?
  fromRoomId     String?            @db.Uuid
  toRoomId       String?            @db.Uuid
  reason         String?
  actorUserId    String?            @db.Uuid
  correlationId  String?
  occurredAt     DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation    Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actor          User?              @relation("ReservationHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, propertyId, reservationId, occurredAt])
}

/// One front-office stay per reservation. Occupancy is derived from an
/// `IN_HOUSE` stay and is intentionally separate from housekeeping state.
model Stay {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  propertyId         String              @db.Uuid
  reservationId      String              @unique @db.Uuid
  guestId            String              @db.Uuid
  roomId             String              @db.Uuid
  status             StayStatus          @default(IN_HOUSE)
  checkedInAt        DateTime
  checkedInByUserId  String?             @db.Uuid
  checkedOutAt       DateTime?
  checkedOutByUserId String?             @db.Uuid
  checkOutNotes      String?
  moveCount          Int                 @default(0)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation        Reservation         @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest              Guest               @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room               Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkedInBy        User?               @relation("StayCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: SetNull)
  checkedOutBy       User?               @relation("StayCheckedOutBy", fields: [checkedOutByUserId], references: [id], onDelete: SetNull)
  incidents          Incident[]
  folios             Folio[]
  payments           Payment[]
  documents          GeneratedDocument[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status])
  @@index([propertyId, roomId, status])
  @@index([organizationId, guestId])
}

/// Operational notes and incidents. Optional scope links allow a note to be
/// about a room, a reservation, a stay or the property in general.
model Incident {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  propertyId       String           @db.Uuid
  roomId           String?          @db.Uuid
  reservationId    String?          @db.Uuid
  stayId           String?          @db.Uuid
  type             IncidentType     @default(NOTE)
  severity         IncidentSeverity @default(MEDIUM)
  status           IncidentStatus   @default(OPEN)
  title            String           @db.VarChar(120)
  description      String
  resolution       String?
  createdByUserId  String?          @db.Uuid
  resolvedByUserId String?          @db.Uuid
  resolvedAt       DateTime?
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property         Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room             Room?            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservation      Reservation?     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  stay             Stay?            @relation(fields: [stayId], references: [id], onDelete: Restrict)
  createdBy        User?            @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy       User?            @relation("IncidentResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status, createdAt])
  @@index([propertyId, roomId, status])
  @@index([organizationId, propertyId, reservationId])
}

model PasswordResetToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  tokenHash       String    @unique @db.VarChar(64)
  expiresAt       DateTime
  usedAt          DateTime?
  requestedIpHash String?   @db.VarChar(64)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  tokenHash       String    @unique @db.VarChar(64)
  expiresAt       DateTime
  usedAt          DateTime?
  requestedIpHash String?   @db.VarChar(64)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// Append-only security/audit trail for authentication and authorization
/// events. organizationId is nullable because failed logins for unknown users
/// have no resolved tenant. The database trigger rejects UPDATE/DELETE/TRUNCATE.
model SecurityEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  userId         String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  type           String
  severity       String        @default("INFO")
  ipHash         String?       @db.VarChar(64)
  userAgent      String?       @db.VarChar(255)
  correlationId  String?
  metadata       Json?
  occurredAt     DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?         @relation("SecurityEventSubject", fields: [userId], references: [id], onDelete: Restrict)
  actor          User?         @relation("SecurityEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([userId, occurredAt])
  @@index([type, occurredAt])
}

// Phase 5 — Folio, cash and operational day.
//
// Folio is the account header; FolioLine stores each charge. Payments are
// linked to a folio only, so the database can always reconcile a payment with
// its account. Money is persisted as DECIMAL(10,2) with an explicit currency.
model Folio {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  propertyId     String      @db.Uuid
  stayId         String?     @db.Uuid
  reservationId  String?     @db.Uuid
  number         String      @db.VarChar(32)
  status         FolioStatus @default(OPEN)
  currencyCode   String      @default("BRL") @db.VarChar(3)
  notes          String?
  idempotencyKey String      @db.VarChar(64)
  openedByUserId String?     @db.Uuid
  closedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  stay         Stay?               @relation(fields: [stayId], references: [id], onDelete: Restrict)
  reservation  Reservation?        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  openedBy     User?               @relation("FolioOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  lines        FolioLine[]
  payments     Payment[]
  documents    GeneratedDocument[]

  @@unique([propertyId, number])
  @@unique([propertyId, idempotencyKey])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, propertyId, createdAt])
  @@index([propertyId, stayId])
  @@index([propertyId, reservationId])
}

model FolioLine {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  propertyId      String          @db.Uuid
  folioId         String          @db.Uuid
  description     String          @db.VarChar(120)
  amount          Decimal         @db.Decimal(10, 2)
  currencyCode    String          @default("BRL") @db.VarChar(3)
  status          FolioLineStatus @default(POSTED)
  postedAt        DateTime        @default(now())
  voidedAt        DateTime?
  voidReason      String?
  idempotencyKey  String          @db.VarChar(64)
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  folio        Folio        @relation(fields: [folioId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("FolioLineCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([propertyId, idempotencyKey])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, folioId, status])
  @@index([organizationId, propertyId, createdAt])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  propertyId       String        @db.Uuid
  folioId          String        @db.Uuid
  amount           Decimal       @db.Decimal(10, 2)
  currencyCode     String        @default("BRL") @db.VarChar(3)
  method           String        @db.VarChar(32)
  status           PaymentStatus @default(COMPLETED)
  referenceId      String?       @db.VarChar(64)
  description      String?
  idempotencyKey   String        @db.VarChar(64)
  receivedByUserId String?       @db.Uuid
  receivedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  folio         Folio        @relation(fields: [folioId], references: [id], onDelete: Restrict)
  receivedBy    User?        @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  Reservation   Reservation? @relation(fields: [reservationId], references: [id])
  reservationId String?      @db.Uuid
  Stay          Stay?        @relation(fields: [stayId], references: [id])
  stayId        String?      @db.Uuid

  @@unique([propertyId, idempotencyKey])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, propertyId, folioId])
  @@index([organizationId, propertyId, createdAt])
}

model CashSession {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  propertyId         String            @db.Uuid
  name               String            @db.VarChar(120)
  operationalDate    DateTime          @db.Date
  openingAmount      Decimal           @db.Decimal(10, 2)
  closingAmount      Decimal?          @db.Decimal(10, 2)
  expectedCashAmount Decimal?          @db.Decimal(10, 2)
  openingByUserId    String?           @db.Uuid
  openedAt           DateTime          @default(now())
  closedAt           DateTime?
  closedByUserId     String?           @db.Uuid
  status             CashSessionStatus @default(OPEN)
  idempotencyKey     String            @db.VarChar(64)
  currencyCode       String            @default("BRL") @db.VarChar(3)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  openedBy     User?          @relation("CashSessionOpenedBy", fields: [openingByUserId], references: [id], onDelete: SetNull)
  closedBy     User?          @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  movements    CashMovement[]

  @@unique([propertyId, idempotencyKey])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, operationalDate])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, propertyId, createdAt])
}

model CashMovement {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  propertyId       String           @db.Uuid
  cashSessionId    String           @db.Uuid
  type             CashMovementType
  amount           Decimal          @db.Decimal(10, 2)
  currencyCode     String           @default("BRL") @db.VarChar(3)
  description      String?
  idempotencyKey   String           @db.VarChar(64)
  recordedByUserId String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  cashSession  CashSession  @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("CashMovementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@unique([propertyId, idempotencyKey])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, cashSessionId])
  @@index([organizationId, propertyId, type])
  @@index([organizationId, propertyId, createdAt])
}

/// One close/reopen row per property and operational date. `snapshot` keeps the
/// totals computed at close time so later edits cannot rewrite history.
model OperationalClose {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @db.Uuid
  propertyId       String                 @db.Uuid
  operationalDate  DateTime               @db.Date
  status           OperationalCloseStatus @default(CLOSED)
  idempotencyKey   String                 @db.VarChar(64)
  snapshot         Json
  notes            String?
  closedByUserId   String?                @db.Uuid
  closedAt         DateTime
  reopenedByUserId String?                @db.Uuid
  reopenedAt       DateTime?
  reopenReason     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  closedBy     User?        @relation("OperationalCloseClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  reopenedBy   User?        @relation("OperationalCloseReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, propertyId, operationalDate])
  @@unique([propertyId, idempotencyKey])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, propertyId, createdAt])
}

/// A versioned, server-rendered document template. `body` is plain text for
/// controlled sections only: it is escaped by the renderer and never treated
/// as arbitrary HTML.
model DocumentTemplate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  propertyId     String    @db.Uuid
  key            String    @db.VarChar(64)
  name           String    @db.VarChar(160)
  locale         String    @default("pt-BR") @db.VarChar(10)
  version        Int
  title          String    @db.VarChar(200)
  body           String    @db.Text
  isPublished    Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdById    String?   @db.Uuid
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents    GeneratedDocument[]

  @@unique([propertyId, key, locale, version])
  @@index([organizationId, propertyId, key, locale, isPublished])
}

/// Immutable snapshot plus the generated PDF bytes. Bytes live in PostgreSQL
/// for v1 because the product has no object-storage provider; downloads are
/// authenticated and never expose a public storage URL.
model GeneratedDocument {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  propertyId      String         @db.Uuid
  templateId      String         @db.Uuid
  number          String         @db.VarChar(48)
  documentType    String         @db.VarChar(64)
  status          DocumentStatus @default(GENERATED)
  locale          String         @db.VarChar(10)
  templateVersion Int
  guestId         String?        @db.Uuid
  reservationId   String?        @db.Uuid
  stayId          String?        @db.Uuid
  folioId         String?        @db.Uuid
  generatedById   String?        @db.Uuid
  generatedAt     DateTime       @default(now())
  snapshot        Json
  content         Bytes
  mimeType        String         @default("application/pdf") @db.VarChar(80)
  fileSizeBytes   Int
  pageCount       Int
  sha256          String         @db.VarChar(64)
  storageKey      String         @db.VarChar(160)
  receivedAt      DateTime?
  receivedById    String?        @db.Uuid
  receivedNotes   String?        @db.Text
  voidedAt        DateTime?
  voidReason      String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  template     DocumentTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  guest        Guest?               @relation("DocumentGuest", fields: [guestId], references: [id], onDelete: Restrict)
  reservation  Reservation?         @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  stay         Stay?                @relation(fields: [stayId], references: [id], onDelete: Restrict)
  folio        Folio?               @relation(fields: [folioId], references: [id], onDelete: Restrict)
  generatedBy  User?                @relation("DocumentGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  receivedBy   User?                @relation("DocumentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  printEvents  DocumentPrintEvent[]

  @@unique([propertyId, number])
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, reservationId, generatedAt])
  @@index([organizationId, propertyId, guestId, generatedAt])
  @@index([organizationId, propertyId, documentType, generatedAt])
}

/// Append-only trail of print/reprint requests. It records that staff opened
/// or requested a print dialog; it never claims a physical printer succeeded.
model DocumentPrintEvent {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  propertyId     String                 @db.Uuid
  documentId     String                 @db.Uuid
  type           DocumentPrintEventType
  requestedById  String?                @db.Uuid
  requestedAt    DateTime               @default(now())
  note           String?                @db.Text
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  document       GeneratedDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy    User?                  @relation("DocumentPrintRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId, propertyId, documentId, requestedAt])
}

/// Structured reservation note or operational instruction. Descriptive notes
/// and actionable instructions share the same record; `actionType` marks the
/// actions that require a human to execute them in another module. Creating one
/// never changes tariffs, folios, cash or payments.
model ReservationInstruction {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @db.Uuid
  propertyId         String                    @db.Uuid
  reservationId      String                    @db.Uuid
  sourceNoteId       String?                   @db.Uuid
  category           InstructionCategory       @default(GENERAL)
  title              String                    @db.VarChar(160)
  body               String                    @db.Text
  /// Free-form pastel tags for filtering and grouping (e.g. VIP, PREAUTH).
  tags               String[]                  @default([])
  priority           InstructionPriority       @default(NORMAL)
  status             InstructionStatus         @default(NEW)
  source             InstructionSource         @default(RESERVATIONS)
  sourceDepartment   String?                   @db.VarChar(64)
  visibility         InstructionVisibility     @default(ALL_AUTHORIZED)
  assignedDepartment String?                   @db.VarChar(64)
  assignedUserId     String?                   @db.Uuid
  actionType         InstructionActionType?
  executionMoment    InstructionExecutionMoment?
  paymentMethod      InstructionPaymentMethod?
  actionDueAt        DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  completedAt        DateTime?
  completedByUserId  String?                   @db.Uuid
  createdByUserId    String?                   @db.Uuid
  dedupeKey          String?                   @db.VarChar(64)
  metadata           Json?
  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property           Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation        Reservation                 @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  sourceNote         ReservationSourceNote?      @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  assignedUser       User?                       @relation("InstructionAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  completedBy        User?                       @relation("InstructionCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdBy          User?                       @relation("InstructionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events              InstructionEvent[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([organizationId, propertyId, id])
  @@unique([sourceNoteId, dedupeKey])
  @@index([organizationId, propertyId, reservationId, status, priority], map: "ReservationInstruction_reservation_status_priority_idx")
  @@index([organizationId, propertyId, reservationId, executionMoment], map: "ReservationInstruction_reservation_moment_idx")
  @@index([organizationId, propertyId, actionDueAt], map: "ReservationInstruction_action_due_idx")
  @@index([organizationId, propertyId, assignedDepartment, status], map: "ReservationInstruction_assigned_department_idx")
  @@index([tags], type: Gin, map: "ReservationInstruction_tags_gin_idx")
}

/// Immutable original text imported from a channel or pasted by staff. Card
/// numbers and CVV are redacted before persistence; `sourceTextHash` keeps a
/// verifiable digest of the exact received text and `contentHash` de-duplicates
/// retries for the same parser version.
model ReservationSourceNote {
  id                  String                    @id @default(uuid()) @db.Uuid
  organizationId      String                    @db.Uuid
  propertyId          String                    @db.Uuid
  reservationId       String                    @db.Uuid
  sourceTextOriginal  String                    @db.Text
  sourceTextHash      String                    @db.VarChar(64)
  contentHash         String                    @db.VarChar(64)
  parserVersion       String                    @db.VarChar(32)
  redacted            Boolean                   @default(false)
  suggestions         Json
  warnings            Json
  sourceSystem        String?                   @db.VarChar(64)
  sourceDepartment    String?                   @db.VarChar(64)
  externalReference   String?                   @db.VarChar(120)
  importedByUserId    String?                   @db.Uuid
  importedAt          DateTime                  @default(now())
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property            Property                  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation         Reservation               @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  importedBy          User?                     @relation("SourceNoteImportedBy", fields: [importedByUserId], references: [id], onDelete: SetNull)
  instructions        ReservationInstruction[]
  createdAt           DateTime                  @default(now())

  @@unique([reservationId, contentHash, parserVersion], map: "ReservationSourceNote_content_version_key")
  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, reservationId, importedAt], map: "ReservationSourceNote_reservation_imported_idx")
}

/// Append-only timeline for instruction status changes. The database trigger
/// rejects UPDATE/DELETE/TRUNCATE.
model InstructionEvent {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  propertyId     String               @db.Uuid
  instructionId  String               @db.Uuid
  eventType      InstructionEventType
  actorUserId    String?              @db.Uuid
  fromStatus     InstructionStatus?
  toStatus       InstructionStatus?
  reason         String?
  metadata       Json?
  occurredAt     DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  instruction    ReservationInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  actor          User?                @relation("InstructionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, propertyId, instructionId, occurredAt], map: "InstructionEvent_instruction_occurred_idx")
}

/// Persistent guest preference or alert. Guest notes are intentionally separate
/// from reservation instructions and are never copied into a reservation
/// automatically.
model GuestNote {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  propertyId      String                @db.Uuid
  guestId         String                @db.Uuid
  category        InstructionCategory   @default(GENERAL)
  body            String                @db.Text
  priority        InstructionPriority   @default(NORMAL)
  visibility      InstructionVisibility @default(ALL_AUTHORIZED)
  purpose         String?               @db.VarChar(64)
  expiresAt       DateTime?
  isActive        Boolean               @default(true)
  createdByUserId String?               @db.Uuid
  updatedByUserId String?               @db.Uuid
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property        Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest           Guest                 @relation(fields: [guestId], references: [id], onDelete: Restrict)
  createdBy       User?                 @relation("GuestNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?                 @relation("GuestNoteUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, propertyId, id])
  @@index([organizationId, propertyId, guestId, isActive])
  @@index([organizationId, propertyId, expiresAt])
}
